# CloudBase 环境信息（控制台“环境总览”）
CLOUDBASE_ENV_ID=your-env-id
CLOUDBASE_REGION=ap-shanghai

# 浏览器可公开使用的 Publishable Key；它不是服务端管理密钥
CLOUDBASE_PUBLISHABLE_KEY=your-publishable-key

# 仅服务端使用的 API Key，严禁加 NEXT_PUBLIC_ 前缀或提交真实值
CLOUDBASE_APIKEY=your-server-api-key

# 上线后的完整网址，用于分享卡片；本地可以不填
SITE_URL=https://your-domain.example.com

# 可选：只有使用自定义 CloudBase API 网关时才填写
# CLOUDBASE_API_BASE_URL=https://your-env-id.api.tcloudbasegateway.com
