# CloudBase 环境信息（控制台“环境总览”）
CLOUDBASE_ENV_ID=your-env-id
CLOUDBASE_REGION=ap-shanghai

# 浏览器可公开使用的 Publishable Key；它不是服务端管理密钥
CLOUDBASE_PUBLISHABLE_KEY=your-publishable-key

# 仅服务端使用的 API Key，严禁加 NEXT_PUBLIC_ 前缀或提交真实值
CLOUDBASE_APIKEY=your-server-api-key

# 上线后的完整网址，用于分享卡片；本地可以不填
SITE_URL=https://your-domain.example.com

# 智谱 AI（服务端密钥，严禁使用 NEXT_PUBLIC_ 前缀）
# 当前默认使用官方标注免费的视觉/文本 Flash 模型
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_VISION_MODEL=glm-4.6v-flash
ZHIPU_TEXT_MODEL=glm-4.7-flash
ZHIPU_VISION_FALLBACK_MODEL=glm-4v-flash
ZHIPU_TEXT_FALLBACK_MODEL=glm-4-flash-250414

# AI 决策顾问团（OpenAI Next Credits 网关 + Pi Runtime，仅服务端使用）
OPENAI_NEXT_API_KEY=your-openai-next-api-key
OPENAI_NEXT_BASE_URL=https://api.openai-next.com/v1
DEEPSEEK_AGENT_MODEL=deepseek-v4-flash

# 可选：只有使用自定义 CloudBase API 网关时才填写
# CLOUDBASE_API_BASE_URL=https://your-env-id.api.tcloudbasegateway.com

# 桌面花设备：本地可先沿用示例编号；上线时务必换成长随机密钥
DEVICE_ID=flower_01
DEVICE_OWNER_ID=CloudBase身份认证中的主人用户ID
DEVICE_SHARED_SECRET=请替换为至少32位随机字符串
